":[["$","h2",null,{"className":"text-xl font-extrabold","children":"How does this calculator work?"}],["$","p",null,{"className":"mt-3 leading-8 text-muted","children":"The calculator converts height from centimeters to meters, squares it and divides weight in kilograms by that value. It then displays a broad adult classification band."}],["$","h3",null,{"className":"mt-6 font-bold","children":"Formula and calculation method"}],["$","p",null,{"className":"mt-2 rounded-xl bg-[#f6f3fb] p-4 font-mono text-sm leading-7 text-[#493078]","children":"BMI = weight in kilograms / (height in meters)²."}],["$","p",null,{"className":"mt-3 text-sm leading-7 text-muted","children":"The calculator applies this method to the values entered above. Review the assumptions below before relying on an estimate."}]]}],["$","section",null,{"className":"card p-6 md:p-8","children":[["$","h2",null,{"className":"text-xl font-extrabold","children":"Example calculation"}],["$","p",null,{"className":"mt-3 leading-8 text-muted","children":"For a person weighing 70 kg and measuring 1.75 m, BMI = 70 / (1.75 × 1.75), or approximately 22.9."}]]}],["$","section",null,{"className":"card p-6 md:p-8","children":[["$","h2",null,{"className":"text-xl font-extrabold","children":["How to use the ","BMI"]}],["$","ol",null,{"className":"mt-4 list-decimal space-y-3 pl-5 text-sm leading-7 text-muted","children":[["$","li",null,{"children":"Enter each requested value using the unit shown beside the field."}],["$","li",null,{"children":["Check the inputs and select ",["$","strong",null,{"className":"text-ink","children":"Calculate result"}],"."]}],["$","li",null,{"children":"Review the headline result, supporting metrics and chart where provided."}],["$","li",null,{"children":"Change one input at a time to compare scenarios, or use Reset to start again."}]]}]]}],["$","section",null,{"className":"card p-6 md:p-8","children":[["$","h2",null,{"className":"text-xl font-extrabold","children":"Tips for interpreting your 